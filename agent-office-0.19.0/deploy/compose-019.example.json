      "name": "kip-ops-capacity-20261101_reports"
    },
    "runtime-code": {
      "name": "kip-agent-office-019-runtime-57e629f"
    },
    "previous-state": {
      "external": true,
      "name": "kip-agent-office-017-candidate-20261101_state"
    },
    "backups": {
      "name": "kip-agent-office-registry-backups-20261102"
    }
  },
  "networks": {
