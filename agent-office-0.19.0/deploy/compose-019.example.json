{
  "services": {
    "office": {
      "image": "kip-agent-office:0.16.0-candidate-ceab366",
      "pull_policy": "never",
      "user": "1000:1000",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "restart": "unless-stopped",
      "mem_limit": "128m",
      "cpus": 0.25,
      "pids_limit": 64,
      "environment": {
        "OBSERVER_MODULE": "/observer/src/store.mjs",
        "OBSERVER_STATE": "/observer-state/ops.sqlite",
        "OFFICE_ORIGIN": "${OFFICE_ORIGIN}",
        "OFFICE_SUPABASE_URL": "${OFFICE_SUPABASE_URL}",
        "OFFICE_PUBLISHABLE_KEY": "${OFFICE_PUBLISHABLE_KEY}",
        "OFFICE_ALLOWED_EMAIL": "${OFFICE_ALLOWED_EMAIL}",
        "OFFICE_ALLOWED_USER_ID": "${OFFICE_ALLOWED_USER_ID}",
        "OFFICE_BOARD_PATH": "/office-state/board.json",
        "OFFICE_SKILLS_PATH": "/office-state/skills.json",
        "OFFICE_TASKS_PATH": "/office-state/tasks.sqlite"
      },
      "ports": [
        "127.0.0.1:18796:3180"
      ],
      "volumes": [
        "observer-code:/observer:ro",
        "observer-state:/observer-state:ro",
        "office-state:/office-state",
        "capacity-reports:/capacity:ro",
        {
          "type": "bind",
          "source": "/opt/kip-agent-office/releases/20261101-roles01-36af8f30/role-data",
          "target": "/role-data",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        "runtime-code:/opt/kip019:ro"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "2m",
          "max-file": "3"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "--input-type=module",
          "-e",
          "import{readFileSync}from'node:fs';const root='/opt/kip019/runtime',v=JSON.parse(readFileSync(root+'/dist/release.json'));const r=await fetch('http://127.0.0.1:3180/healthz');if(v.version!=='0.19.0'||readFileSync(root+'/.ready','utf8')!=='57e629fd5d1dcc6da249e2626d5d265546b21bfa'||v.autoReply!==false||!r.ok||(await r.json()).service!=='kip-agent-office')process.exit(1)"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 4
      },
      "working_dir": "/opt/kip019/runtime",
      "command": [
        "node",
        "server/main.mjs"
      ],
      "depends_on": {
        "prepare": {
          "condition": "service_completed_successfully"
        }
      }
    },
    "probe": {
      "image": "kip-agent-office:0.16.0-candidate-ceab366",
      "pull_policy": "never",
      "user": "1000:1000",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "restart": "no",
      "mem_limit": "128m",
      "cpus": 0.2,
      "pids_limit": 32,
      "depends_on": {
        "office": {
          "condition": "service_healthy"
        }
      },
      "volumes": [
        "office-state:/source:ro",
        "runtime-code:/opt/kip019:ro"
      ],
      "command": [
        "node",
        "scripts/ops-probe.mjs"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      },
      "tmpfs": [
        "/tmp:size=16m,mode=1777,nosuid,noexec"
      ],
      "working_dir": "/opt/kip019/runtime"
    },
    "prepare": {
      "image": "kip-agent-office:0.16.0-candidate-ceab366",
      "pull_policy": "never",
      "user": "1000:1000",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "restart": "no",
      "mem_limit": "256m",
      "cpus": 0.5,
      "pids_limit": 64,
      "tmpfs": [
        "/tmp:rw,nosuid,nodev,noexec,size=32m,mode=1777"
      ],
      "volumes": [
        "runtime-code:/office-state"
      ],
      "command": [
        "node",
        "--input-type=module",
        "-e",
        "import{writeFileSync}from'node:fs';import{createHash}from'node:crypto';const r=await fetch('https://raw.githubusercontent.com/szultami-bit/KIP-Play/fc531e5047e9f033101b522e6cadc98a0c80cc72/agent-office-0.19.0/scripts/prepare-runtime-019.mjs',{signal:AbortSignal.timeout(20000)});if(!r.ok)throw Error('BOOTSTRAP_HTTP_'+r.status);const b=Buffer.from(await r.arrayBuffer());if(createHash('sha256').update(b).digest('hex')!=='c80dd0e631471aa337f116046833692e3d4d387f7a3c3e96444e1e89c60aa148')throw Error('BOOTSTRAP_HASH_MISMATCH');writeFileSync('/tmp/prepare-runtime.mjs',b);await import('file:///tmp/prepare-runtime.mjs');"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "2m",
          "max-file": "3"
        }
      },
      "depends_on": {
        "permissions": {
          "condition": "service_completed_successfully"
        }
      }
    },
    "permissions": {
      "image": "kip-agent-office:0.16.0-candidate-ceab366",
      "pull_policy": "never",
      "user": "0:0",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "cap_add": [
        "CHOWN",
        "FOWNER",
        "DAC_OVERRIDE"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "restart": "no",
      "mem_limit": "64m",
      "cpus": 0.2,
      "pids_limit": 32,
      "volumes": [
        "runtime-code:/office-state"
      ],
      "command": [
        "node",
        "--input-type=module",
        "-e",
        "import{lstatSync,readdirSync,chownSync,chmodSync}from'node:fs';import{join}from'node:path';function visit(p){const s=lstatSync(p);if(s.isSymbolicLink())throw Error('NO_SYMLINKS');chownSync(p,1000,1000);chmodSync(p,s.isDirectory()?0o750:0o640);if(s.isDirectory())for(const n of readdirSync(p))visit(join(p,n));}visit('/office-state');console.log('RUNTIME_VOLUME_READY');"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      }
    }
  },
  "volumes": {
    "observer-code": {
      "external": true,
      "name": "kip-ops-hybrid-20261031_code_v01"
    },
    "observer-state": {
      "external": true,
      "name": "kip-ops-hybrid-20261031_state_v01"
    },
    "office-state": {
