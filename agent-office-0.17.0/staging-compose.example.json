        "driver": "json-file",
        "options": {
          "max-size": "2m",
          "max-file": "3"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "--input-type=module",
          "-e",
          "import{readFileSync}from'node:fs';const v=JSON.parse(readFileSync('/opt/kip017/runtime/dist/release.json'));const r=await fetch('http://127.0.0.1:3180/healthz');if(v.version!=='0.17.0'||v.patch!=='authority-dropdown-refresh'||!r.ok||(await r.json()).service!=='kip-agent-office')process.exit(1)"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 4
      },
      "working_dir": "/opt/kip017/runtime",
      "command": [
        "node",
        "server/main.mjs"
      ],
      "depends_on": {
        "prepare": {
          "condition": "service_completed_successfully"
        }
      }
    },
    "probe": {
      "image": "kip-agent-office:0.16.0-candidate-ceab366",
      "pull_policy": "never",
      "user": "1000:1000",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "restart": "no",
      "mem_limit": "64m",
      "cpus": 0.2,
      "pids_limit": 32,
      "depends_on": {
        "office": {
          "condition": "service_healthy"
        }
      },
      "volumes": [
        "office-state:/office-state",
        "runtime-code:/opt/kip017:ro"
      ],
      "command": [
        "node",
        "scripts/registry-probe.mjs"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      },
      "working_dir": "/opt/kip017/runtime"
    },
    "prepare": {
      "image": "kip-agent-office:0.16.0-candidate-ceab366",
      "pull_policy": "never",
      "user": "1000:1000",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "restart": "no",
      "mem_limit": "256m",
      "cpus": 0.5,
      "pids_limit": 64,
      "tmpfs": [
        "/tmp:rw,nosuid,nodev,noexec,size=32m,mode=1777"
      ],
      "volumes": [
        "runtime-code:/office-state"
      ],
      "command": [
        "node",
        "--input-type=module",
        "-e",
        "import{writeFileSync}from'node:fs';import{createHash}from'node:crypto';const r=await fetch('https://raw.githubusercontent.com/szultami-bit/KIP-Play/58cec2e1155da1a2d374da587d9bc6a52af0689e/agent-office-0.17.0/scripts/prepare-runtime.mjs',{signal:AbortSignal.timeout(20000)});if(!r.ok)throw Error('BOOTSTRAP_HTTP_'+r.status);const b=Buffer.from(await r.arrayBuffer());if(createHash('sha256').update(b).digest('hex')!=='1d4fd076f2c08f291ac47474e7989ab19d61b3e90fc45be7c96eba90835052c7')throw Error('BOOTSTRAP_HASH_MISMATCH');writeFileSync('/tmp/prepare-runtime.mjs',b);await import('file:///tmp/prepare-runtime.mjs');"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "2m",
          "max-file": "3"
        }
      },
      "depends_on": {
        "permissions": {
          "condition": "service_completed_successfully"
        }
      }
    },
    "permissions": {
      "image": "kip-agent-office:0.16.0-candidate-ceab366",
      "pull_policy": "never",
      "user": "0:0",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "cap_add": [
        "CHOWN",
        "FOWNER",
        "DAC_OVERRIDE"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "restart": "no",
      "mem_limit": "64m",
      "cpus": 0.2,
      "pids_limit": 32,
      "volumes": [
        "runtime-code:/office-state"
      ],
      "command": [
        "node",
        "--input-type=module",
        "-e",
        "import{lstatSync,readdirSync,chownSync,chmodSync}from'node:fs';import{join}from'node:path';const visit=p=>{const s=lstatSync(p);if(s.isSymbolicLink())throw Error('NO_SYMLINKS');chownSync(p,1000,1000);chmodSync(p,s.isDirectory()?0o750:0o640);if(s.isDirectory())for(const name of readdirSync(p))visit(join(p,name));};visit('/office-state');console.log('CANDIDATE_CODE_VOLUME_OWNERSHIP_READY');"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      }
    }
