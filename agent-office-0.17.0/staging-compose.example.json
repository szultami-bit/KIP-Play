{
  "services": {
    "office": {
      "image": "kip-agent-office:0.16.0-candidate-ceab366",
      "pull_policy": "never",
      "user": "1000:1000",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "restart": "unless-stopped",
      "mem_limit": "128m",
      "cpus": 0.25,
      "pids_limit": 64,
      "environment": {
        "OBSERVER_MODULE": "/observer/src/store.mjs",
        "OBSERVER_STATE": "/observer-state/ops.sqlite",
        "OFFICE_ORIGIN": "https://agent-staging.kampunginggrispontianak.com",
        "OFFICE_SUPABASE_URL": "${OFFICE_SUPABASE_URL}",
        "OFFICE_PUBLISHABLE_KEY": "sb_publishable_Gv9ickEe9qSEAqQffHUgTg_mqcU-Yf0",
        "OFFICE_ALLOWED_EMAIL": "szultami@gmail.com",
        "OFFICE_ALLOWED_USER_ID": "204a2cd8-9cdf-490e-9bbf-6351b7febd63",
        "OFFICE_BOARD_PATH": "/office-state/board.json",
        "OFFICE_SKILLS_PATH": "/office-state/skills.json"
      },
      "ports": [
        "127.0.0.1:18796:3180"
      ],
      "volumes": [
        "observer-code:/observer:ro",
        "observer-state:/observer-state:ro",
        "office-state:/office-state",
